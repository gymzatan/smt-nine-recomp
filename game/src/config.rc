#pragma code_page(65001)
#include <windows.h>
#include "app.rc"
100 DIALOGEX 0,0,300,336
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shin Megami Tensei - NINE 设置"
FONT 9,"Microsoft YaHei UI"
BEGIN
    LTEXT "界面语言 / 表示言語 /\nInterface Language",130,12,8,94,22
    COMBOBOX 110,112,10,176,64,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "渲染后端",121,12,36,94,12
    COMBOBOX 101,112,32,176,88,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "内部渲染倍率",122,12,58,94,12
    COMBOBOX 102,112,54,176,64,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "游戏画面比例",125,12,80,94,12
    COMBOBOX 105,112,76,176,76,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "游戏语言",126,12,102,94,12
    COMBOBOX 106,112,98,176,64,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "导入或更新语言 ISO…",108,112,120,176,18
    LTEXT "画面刷新率",127,12,152,94,12
    COMBOBOX 107,112,148,176,64,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "窗口尺寸",128,12,174,94,12
    COMBOBOX 112,112,170,176,144,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "自定义尺寸",133,12,196,94,12
    EDITTEXT 103,112,192,56,14,ES_NUMBER | WS_TABSTOP
    LTEXT "×",-1,175,195,12,12
    EDITTEXT 104,194,192,56,14,ES_NUMBER | WS_TABSTOP
    CONTROL "固定窗口宽高比（Fixed Aspect Ratio）",132,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,215,276,14
    LTEXT "宽屏增加场景两侧视野，界面保持比例。\n窗口尺寸独立于游戏画面比例，多余区域留黑。\n设置在下次启动游戏时生效。",129,12,237,276,40
    LTEXT "可导入翻译后的 ISO；更新时使用相同语言标识。",109,12,283,276,16
    PUSHBUTTON "操作说明",111,12,309,82,18
    PUSHBUTTON "按键设置",113,100,309,58,18
    DEFPUSHBUTTON "保存",IDOK,164,309,58,18
    PUSHBUTTON "取消",IDCANCEL,230,309,58,18
END
200 DIALOGEX 0,0,300,115
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "导入或更新语言"
FONT 9,"Microsoft YaHei UI"
BEGIN
    LTEXT "语言标识",203,12,16,72,12
    EDITTEXT 201,90,12,196,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显示名称",204,12,44,72,12
    EDITTEXT 202,90,40,196,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "更新已有语言时，保留相同标识。",205,12,66,274,12
    DEFPUSHBUTTON "选择 ISO…",IDOK,140,87,72,20
    PUSHBUTTON "取消",IDCANCEL,220,87,66,20
END

300 DIALOGEX 0,0,340,270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "操作说明"
FONT 9,"Microsoft YaHei UI"
BEGIN
    EDITTEXT 301,12,10,316,224,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "关闭",IDOK,260,242,68,18
END

400 DIALOGEX 0,0,450,300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Control bindings"
FONT 9,"Microsoft YaHei UI"
BEGIN
    LTEXT "Game action",410,12,10,140,12
    LISTBOX 401,12,27,150,194,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT "Keyboard",411,176,30,250,12
    COMBOBOX 402,176,47,260,180,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Capture",406,176,72,110,19
    LTEXT "Controller (XInput)",412,176,108,250,12
    COMBOBOX 403,176,125,260,180,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Capture",407,176,150,110,19
    LTEXT "",408,176,185,260,32
    LTEXT "",413,12,230,426,36
    PUSHBUTTON "Restore defaults",405,12,273,100,18
    DEFPUSHBUTTON "Apply",IDOK,300,273,66,18
    PUSHBUTTON "Cancel",IDCANCEL,374,273,64,18
