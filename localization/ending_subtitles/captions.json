{
  "videos": [
    {
      "number": 27,
      "cues": [
        {
          "start": 31.066,
          "end": 36.566,
          "chinese": "法之神已消亡，\n人类也摆脱了管理社会的束缚……"
        },
        {
          "start": 36.566,
          "end": 41.566,
          "chinese": "人类终将在混沌之中，\n寻回自身本来的模样。"
        },
        {
          "start": 41.566,
          "end": 46.566,
          "chinese": "然而，自由与支配犹如光影，\n互为表里。"
        },
        {
          "start": 46.566,
          "end": 51.566,
          "chinese": "自由孕育支配，\n支配亦孕育自由。"
        },
        {
          "start": 51.566,
          "end": 56.566,
          "chinese": "身为追求无垢之境的人，"
        },
        {
          "start": 56.566,
          "end": 62.033,
          "chinese": "你可明白其中的含义，\n人之子啊……"
        }
      ]
    },
    {
      "number": 28,
      "cues": [
        {
          "start": 31.066,
          "end": 36.566,
          "chinese": "你们斩断了与昔日被称为神者的羁绊，"
        },
        {
          "start": 36.566,
          "end": 41.566,
          "chinese": "为旧世界画上了句号。"
        },
        {
          "start": 41.566,
          "end": 46.566,
          "chinese": "从今往后，人类将不再依赖任何存在，"
        },
        {
          "start": 46.566,
          "end": 51.566,
          "chinese": "由人类引领、以科学为本的世界，\n即将开启。"
        },
        {
          "start": 51.566,
          "end": 56.566,
          "chinese": "永世长存的和平世界——"
        },
        {
          "start": 56.566,
          "end": 62.033,
          "chinese": "千年王国……"
        }
      ]
    },
    {
      "number": 33,
      "cues": [
        {
          "start": 31.066,
          "end": 36.566,
          "chinese": "混沌与秩序……\n都不过是偏执欲望的产物。"
        },
        {
          "start": 36.566,
          "end": 41.566,
          "chinese": "那不受任何一方束缚、\n深藏于内心的灵光，"
        },
        {
          "start": 41.566,
          "end": 46.566,
          "chinese": "才是向人类揭示真相、\n传授灵知的救主之证。"
        },
        {
          "start": 46.566,
          "end": 51.566,
          "chinese": "待最后一个灵魂获得救赎，\n宇宙也将失去存在的意义，归于消亡。"
        },
        {
          "start": 51.566,
          "end": 56.566,
          "chinese": "届时，你将挣脱名为肉体的牢笼，\n回到我的身边。"
        },
        {
          "start": 56.566,
          "end": 62.033,
          "chinese": "回到人类本应归属的地方……"
        }
      ]
    },
