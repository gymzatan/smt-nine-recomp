+static void colour_logic_op(const struct wined3d_gl_info *gl_info,
+        const struct wined3d_blend_state *state)
+{
+    static const GLenum operations[] = {
+        GL_CLEAR, GL_SET, GL_COPY, GL_COPY_INVERTED, GL_NOOP, GL_INVERT,
+        GL_AND, GL_NAND, GL_OR, GL_NOR, GL_XOR, GL_EQUIV,
+        GL_AND_REVERSE, GL_AND_INVERTED, GL_OR_REVERSE, GL_OR_INVERTED,
+    };
+    if (state && state->desc.logic_op_enable)
+    {
+        gl_info->gl_ops.gl.p_glLogicOp(operations[state->desc.logic_op]);
+        gl_info->gl_ops.gl.p_glEnable(GL_COLOR_LOGIC_OP);
+    }
+    else
+        gl_info->gl_ops.gl.p_glDisable(GL_COLOR_LOGIC_OP);
+    checkGLcall("colour logic operation");
+}
